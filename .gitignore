# committed on purpose and must NOT be caught by these patterns.
/stress_test_*.csv
/stress_test_*.log
/stress_test_*.png
/over_air_runs/
/over_air_*.csv
/field_distance_rx_*.csv
/field_distance_tx_*.csv
/field_distance_summary_*.csv
/v2x_rx_*.csv
/v2x_tx_*.csv

